{
  "name": "popup-book-motion",
  "version": "1.0.0",
  "description": "A stop-motion paper pop-up book built entirely with Remotion",
  "license": "MIT",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PopupBook out/popup-book.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-bitrate=192k",
    "still": "remotion still src/index.ts PopupBook out/still.png",
    "audio": "python scripts/build_audio.py",
    "textures": "python scripts/gen_textures.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
